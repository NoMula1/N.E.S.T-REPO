# Default bot token
TOKEN="your-default-bot-token"

# Admin bot token
TOKEN_ADMIN="your-admin-bot-token"

# MongoDB connection string
MONGO_URI="your-mongodb-connection-string"

# Optional error webhook for debug alerts
ERROR_WEBHOOK_URL="https://discord.com/api/webhooks/id/token"

# Optional explicit evaluator user ID
EVAL_EXPLICIT_ID="123456789012345678"
# Claude API key (for the NightHawk AI feature)
ANTHROPIC_API_KEY="your-anthropic-key"

# Primary NightHawk Discord guild ID (only this server can use AI in v1)
NIGHTHAWK_GUILD_ID="your-guild-id"

# Discord ID of the NightHawk owner — gets elevated 'owner privilege'
# when interacting with NightHawk AI. Optional; leave blank for none.
NIGHTHAWK_OWNER_ID=""
